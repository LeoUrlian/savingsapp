# Copie para .env e preencha. O .env NUNCA vai pro git (ver .gitignore).

# --- Banco de desenvolvimento da própria Migra (o container docker) ---
DATABASE_URL=postgresql://savings:savings_dev_pw@localhost:5432/savings

# --- API ---
API_PORT=3333

# --- Provedor de IA (preenchemos na Fatia 2) ---
# Sem estas duas variaveis a rota de analise responde 503 e o resto do app funciona.
# AI_MODEL: nome do modelo da OpenAI ao qual sua conta tem acesso.
# OPENAI_API_KEY=
# AI_MODEL=
# AI_BASE_URL: opcional. Padrao e a OpenAI. Troque para usar um provedor gratis,
# ex.: https://api.groq.com/openai/v1  (a chave e o modelo passam a ser os dele).
# AI_BASE_URL=
