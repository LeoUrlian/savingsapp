// Schema do Prisma — SavingsApp
// Modelo declarativo: você descreve o ESTADO desejado das tabelas e o Prisma
// calcula o diff (a migration) por você. Oposto das migrations imperativas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Moedas suportadas (espelha o tipo Currency do @migra/shared).
enum Currency {
  BRL
  USD
  EUR
}

/// Meta de poupança: um objetivo com valor-alvo numa moeda base.
model Goal {
  id               String    @id @default(uuid())
  name             String
  /// Valor-alvo em centavos (inteiro evita erro de ponto flutuante com dinheiro).
  targetAmountCents Int
  baseCurrency     Currency  @default(BRL)
  /// Data-alvo opcional para alcançar a meta.
  targetDate       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deposits         Deposit[]

  /// Dono da meta. Nulo so em metas criadas antes da autenticacao existir.
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

/// Um aporte (depósito) em direção a uma meta.
model Deposit {
  id          String   @id @default(uuid())
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Valor do aporte em centavos.
  amountCents Int
  currency    Currency @default(BRL)
  createdAt   DateTime @default(now())

  @@index([goalId])
  @@map("deposits")
}

/// Usuario do app. A senha nunca e guardada: so o hash (scrypt + sal).
model User {
  id           String    @id @default(uuid())
  /// Sempre em minusculas.
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  goals        Goal[]
  sessions     Session[]

  @@map("users")
}

/// Sessao de login. O cookie leva um token aleatorio; aqui fica so o SHA-256
/// dele, entao um vazamento do banco nao entrega sessoes validas.
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}
