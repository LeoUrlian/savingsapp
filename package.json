{
  "name": "migra",
  "version": "0.0.1",
  "private": true,
  "description": "Migra — plataforma de migração e validação de dados assistida por IA",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "dev:api": "pnpm --filter @migra/api start:dev",
    "dev:web": "pnpm --filter @migra/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
