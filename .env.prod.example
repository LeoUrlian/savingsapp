# Copie para .env.prod e preencha. O .env.prod NUNCA vai para o git.

# Endereço público, sem https:// (ex.: poupanca.exemplo.com).
# Com um domínio real apontado para esta máquina, o HTTPS é automático.
# Para testar no seu PC, deixe localhost.
DOMAIN=localhost

# Senha do banco. Use algo longo e aleatório.
# Gerar: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# IA (opcional)
OPENAI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.groq.com/openai/v1
